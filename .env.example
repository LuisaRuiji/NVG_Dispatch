# Copy this file to .env for Docker Compose deployments.
# Do not commit .env. Generate fresh secret values per deployment.

# ASP.NET Core environment loaded by docker-compose.yml.
ASPNETCORE_ENVIRONMENT=Production

# Required API database connection string.
# Use the same SQL Server password value configured in SA_PASSWORD below.
ConnectionStrings__DefaultConnection=Server=db;Database=NVGDispatch;User Id=sa;Password=REPLACE_WITH_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False

# Required JWT settings.
# Jwt__Key must be at least 32 random bytes/characters.
Jwt__Key=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
Jwt__Issuer=NVGInventory
Jwt__Audience=NVGInventory
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7
Jwt__ClockSkewMinutes=1

# Required browser/API origin settings.
# Separate multiple origins with commas or semicolons.
FrontendBaseUrl=https://app.example.com
Cors__AllowedOrigins=https://app.example.com

# Required SQL Server password for the Docker Compose db service.
SA_PASSWORD=REPLACE_WITH_STRONG_SQL_SERVER_PASSWORD

# Required field-level encryption key.
# Use at least 32 random bytes/characters, base64, or hex.
EncryptionKey=REPLACE_WITH_32_PLUS_BYTE_RANDOM_ENCRYPTION_KEY

# Future AI document extraction / storage settings.
# Replace these when the AWS Textract/S3 integration is enabled.
AWS__AccessKey=REPLACE_WITH_AWS_ACCESS_KEY
AWS__SecretKey=REPLACE_WITH_AWS_SECRET_KEY
AWS__Region=ap-southeast-1
AWS__S3Bucket=REPLACE_WITH_S3_BUCKET_NAME
