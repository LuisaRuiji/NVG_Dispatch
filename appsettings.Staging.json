{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FrontendBaseUrl": "https://staging.example.com",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "NVGInventory",
    "Audience": "NVGInventory",
    "AccessTokenMinutes": 60
  },
  "Dispatching": {
    "DocVerificationEnabled": true
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  },
  "BackgroundJobs": {
    "IntegrityCheck": {
      "Enabled": true,
      "IntervalMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
