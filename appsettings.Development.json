{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NVG_Inventory;Trusted_Connection=True;Trust Server Certificate=True"
  },
  "FrontendBaseUrl": "http://localhost:5173",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Jwt": {
    "Issuer": "NVGInventory",
    "Audience": "NVGInventory",
    "AccessTokenMinutes": 60
  },
  "Seed": {
    "DevPassword": "plaintext"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  },
  "BackgroundJobs": {
    "IntegrityCheck": {
      "Enabled": false,
      "IntervalMinutes": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
